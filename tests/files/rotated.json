{
  "ietf-keystore:keystore": {
    "asymmetric-keys": {
      "asymmetric-key": [
        {
          "name": "sysrepo-gnxi-server-key",
          "private-key-format": "ietf-crypto-types:one-asymmetric-key-format",
          "cleartext-private-key": "",
          "certificates": {
            "certificate": [
              {
                "name": "sysrepo-gnxi-server-cert",
                "cert-data": ""
              }
            ]
          }
        }
      ]
    }
  },
  "ietf-truststore:truststore": {
    "certificate-bags": {
      "certificate-bag": [
        {
          "name": "sysrepo-gnxi-client-ca-bundle",
          "certificate": [
            {
              "name": "ca",
              "cert-data": ""
            }
          ]
        }
      ]
    }
  },
  "sysrepo-gnxi-users:users": {
    "user": [
      {
        "name": "alice",
        "password": "$6$SaltForAlice$B0mGKNyu8MnxZe9IkjoaJIgqqWFVyNWyD9QIrTyp2j0mMBKEOiFiVq3EXn6eI4RLKMuy6Wr8sLWvJ0IZ266hj/"
      },
      {
        "name": "bob",
        "password": "$5$SaltForBob$N8GciXki/e36uKpWqk6NCjQIoOEWOcSNVw15dmbktM9"
      },
      {
        "name": "chuck",
        "password": "$1$SaltForC$hmKZ7F1LZlmIqUt.0lles."
      }
    ]
  },
  "ietf-netconf-acm:nacm": {
    "enable-nacm": true,
    "read-default": "deny",
    "write-default": "deny",
    "exec-default": "deny",
    "groups": {
      "group": [
        {
          "name": "admin",
          "user-name": [
            "alice"
          ]
        },
        {
          "name": "readonly",
          "user-name": [
            "bob"
          ]
        }
      ]
    },
    "rule-list": [
      {
        "name": "admin-all",
        "group": [
          "admin"
        ],
        "rule": [
          {
            "name": "all",
            "access-operations": "*",
            "action": "permit"
          }
        ]
      },
      {
        "name": "test-ro",
        "group": [
          "readonly"
        ],
        "rule": [
          {
            "name": "read",
            "module-name": "sysrepo-gnxi-test",
            "access-operations": "read",
            "action": "permit"
          }
        ]
      }
    ]
  },
  "sysrepo-gnxi-server:server": {
    "listen": {
      "endpoint": [
        {
          "name": "main",
          "ip": {
            "address": "127.0.0.1",
            "port": 50052
          }
        }
      ]
    },
    "tls": {
      "server-identity": {
        "certificate": {
          "central-keystore-reference": {
            "asymmetric-key": "sysrepo-gnxi-server-key",
            "certificate": "sysrepo-gnxi-server-cert"
          }
        }
      },
      "client-authentication": {
        "ca-certs": {
          "central-truststore-reference": "sysrepo-gnxi-client-ca-bundle"
        }
      }
    }
  }
}
