module sysrepo-gnxi-test-clash {
  yang-version 1.1;
  namespace "urn:sysrepo:gnxi:test-clash";
  prefix sgtc;

  organization
    "CESNET, z.s.p.o.";
  contact
    "Ondrej Kusnirik <kusnirik@cesnet.cz>";
  description
    "sysrepo-gnxi test module - its top-level node name clashes with
     sysrepo-gnxi-test to exercise ambiguous bare-name path resolution.

