# .clang-format
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never

BreakBeforeBraces: Allman     # Open braces on a new line
AllowShortIfStatementsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline

ColumnLimit: 100               # Max line length (can be 80, 100, or more)
PointerAlignment: Right        # `int* ptr` vs `int *ptr`

IncludeBlocks: Preserve
SortIncludes: true

SpacesBeforeTrailingComments: 1
SpaceBeforeParens: ControlStatements

Cpp11BracedListStyle: true

AlignAfterOpenBracket: DontAlign   # fixed-indent continuations instead of paren alignment
IndentPPDirectives: AfterHash      # indent nested preprocessor directives after '#'
EmptyLineBeforeAccessModifier: Always # blank line before every access modifier

InsertBraces: true
InsertNewlineAtEOF: true
MaxEmptyLinesToKeep: 2
SeparateDefinitionBlocks: Always
RemoveSemicolon: true
RemoveParentheses: ReturnStatement
