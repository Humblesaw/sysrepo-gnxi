module sysrepo-gnxi-users {
  yang-version 1.1;
  namespace "urn:sysrepo:gnxi:users";
  prefix sgu;

  import iana-crypt-hash {
    prefix ianach;
  }

  description
    "User database for the sysrepo-gnxi gNMI server.

     Defines users with (optionally) hashed passwords and
     per-YANG-module access control lists (ACLs).

     This module is installed into sysrepo and its data is stored in
     the running datastore.  It is private: it must never be accessible
     via gNMI RPCs.  Protection is enforced by a code-level blocklist
     in the server and by filesystem permissions (0600) on the module
     data file.";

  revision 2026-08-26 {
    description "Install into sysrepo instead of a private libyang context.";
  }

  revision 2026-07-28 {
    description "Initial revision.";
  }

  typedef access-level {
    type enumeration {
      enum ro {
        description "Read-only access to the module.";
      }
      enum rw {
        description "Read-write access to the module.";
      }
    }
    description "Access level granted for a YANG module.";
  }

  container users {
    description "User database root container.";

    list user {
      key "name";
      description "A user account.";

      leaf name {
        type string {
          pattern '[a-zA-Z0-9_-]+';
        }
        description "Username (alphanumeric, dash, underscore only).";
      }

      leaf password {
        type ianach:crypt-hash;
        mandatory true;
        must "not(starts-with(., '$0$'))" {
          error-message
            "Plaintext passwords are not allowed, store a hash";
        }
        description
          "Password in the iana-crypt-hash crypt-hash format
           '$<id>$<salt>$<hash>' with the hash function identified by
           <id>: 1 (MD5-crypt), 5 (SHA-256-crypt) or 6 (SHA-512-crypt).
           The '$0$' cleartext form is not allowed.";
      }

      list acl {
        key "module";
        description
          "Access control list entries for this user.
           Each entry grants access to a YANG module.";

        leaf module {
          type string;
          description
            "YANG module name.";
        }

        leaf access {
          type access-level;
          mandatory true;
          description "Access level granted to this module.";
        }
      }
    }
  }
}
